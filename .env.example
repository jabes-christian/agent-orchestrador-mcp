# Copie este arquivo para .env e preencha os segredos antes de `docker compose up -d`
# (spec.md -> P1 "Stack completo via docker-compose", Independent Test).
# .env nunca deve ser versionado (ja garantido por .gitignore).

# --- Gateway (src/orchestrator/settings.py) ---

# Chave que o cliente HTTP deve enviar no header X-API-Key em toda chamada a POST /tasks
# (MCPO-06). Sem default -- obrigatoria.
ORCHESTRATOR_API_KEY=troque-por-uma-chave-secreta

# Credenciais do provider de LLM via OpenRouter (AD-003). Sem default -- obrigatorias.
OPENROUTER_API_KEY=troque-pela-sua-api-key-do-openrouter
OPENROUTER_MODEL=openai/gpt-4o-mini

# Limites do loop ReAct e de timeout (MCPO-03, MCPO-05). Valores abaixo sao os defaults do
# codigo -- descomente e ajuste so se precisar de um valor diferente.
# MAX_REACT_ITERATIONS=5
# MCP_TOOL_TIMEOUT_S=30
# REQUEST_TIMEOUT_S=120

# --- MCP server "github" (docker/github/Dockerfile, consumidas pelo binario github-mcp-server) ---

# Personal Access Token do GitHub, usado pelo github-mcp-server para autenticar na API do
# GitHub (spec.md -> P1 AC2, "PAT do GitHub"). Sem default -- obrigatorio.
GITHUB_PERSONAL_ACCESS_TOKEN=troque-pelo-seu-pat-do-github

# Restringe o github-mcp-server a tools de leitura, no nivel do proprio server (nao do
# gateway). Default seguro: habilitado.
#
# ATENCAO: GITHUB_READ_ONLY e a allowlist de write_tools em config/tool_policy.yaml sao dois
# portoes INDEPENDENTES -- nenhum substitui o outro. Uma tool de escrita presente na
# allowlist do gateway ainda falha no proprio github-mcp-server se GITHUB_READ_ONLY=1; e
# desligar GITHUB_READ_ONLY sozinho nao basta se a tool continuar fora da allowlist do
# gateway. Para habilitar escrita de verdade no GitHub, os dois portoes precisam permitir a
# operacao (design.md -> Risks & Concerns).
GITHUB_READ_ONLY=1
